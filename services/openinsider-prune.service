[Unit]
Description=Delete OpenInsider filings older than one week

[Service]
Type=oneshot
WorkingDirectory=%h/Documents/projects/df-FinanceTerminal
EnvironmentFile=-%h/.config/df-financeterminal/openinsider.env
ExecStart=/usr/bin/python3 %h/Documents/projects/df-FinanceTerminal/tools/openInsider/__init__.py prune
NoNewPrivileges=true
PrivateTmp=true

