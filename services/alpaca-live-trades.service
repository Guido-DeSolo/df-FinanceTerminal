[Unit]
Description=Stream Alpaca live trades (defaults to BTC/USD)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Documents/projects/df-FinanceTerminal
EnvironmentFile=%h/.config/df-financeterminal/alpaca-live-trades.env
ExecStart=/usr/bin/python3 %h/Documents/projects/df-FinanceTerminal/tools/liveOrderBooks/__init__.py
Restart=always
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
