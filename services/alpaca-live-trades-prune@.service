[Unit]
Description=Delete Alpaca live trades older than %i

[Service]
Type=oneshot
WorkingDirectory=%h/Documents/projects/df-FinanceTerminal
EnvironmentFile=-%h/.config/df-financeterminal/alpaca-live-trades.env
ExecStart=/usr/bin/python3 __main__.py liveOrderBooks --prune-older-than %i
NoNewPrivileges=true
PrivateTmp=true
