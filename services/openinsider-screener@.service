[Unit]
Description=Collect OpenInsider screener filings (interval %i)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Documents/projects/df-FinanceTerminal
EnvironmentFile=-%h/.config/df-financeterminal/openinsider.env
ExecStart=/usr/bin/python3 __main__.py openInsider screener
NoNewPrivileges=true
PrivateTmp=true
